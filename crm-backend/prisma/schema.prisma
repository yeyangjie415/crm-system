generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./crm.db"
}

model User {
  id              String   @id
  name            String
  username        String   @unique
  password        String
  role            String
  permissionLevel String
  avatar          String?
  createdAt       String
  lastLogin       String?
  disabled        Boolean  @default(false)
  managerId       String?  // 直属主管（报销一级审核人）
}

model Customer {
  id                String   @id
  name              String
  shortName         String?
  region            String
  type              String
  positioning       String
  customerAttribute String?
  createdBy         String
  createdByName     String
  createdAt         String
  notes             String?
  deleted           Boolean  @default(false)
  hiddenBy          String   @default("[]")   // JSON array
  deletedBy         String?
  deletedAt         String?
  provinceCode      String?
  provinceName      String?
  cityCode          String?
  cityName          String?
  districtCode      String?
  districtName      String?
  detailedAddress   String?
  ownedBy           String?
  ownedByName       String?
  lastActivityAt    String?
  reclaimedAt       String?
  reclaimDays       Int      @default(30)
  // JSON fields stored as strings
  accessControl     String   @default("[]")   // JSON array of CustomerAccess
  annotations       String   @default("[]")   // JSON array of CustomerAnnotation

  contacts          Contact[]
  projects          Project[]
  contracts         Contract[]
  expenses          Expense[]
}

model Contact {
  id          String   @id
  name        String
  phone       String
  position    String
  description String?
  describedBy String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Project {
  id              String   @id
  name            String
  customerId      String
  customerName    String
  contactName     String?
  reportStatus    String
  followStatus    String
  amount          Float
  nextFollowUp    String?
  nextFollowUpDate String?
  createdAt       String
  createdBy       String

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model FollowRecord {
  id        String @id
  projectId String
  content   String
  recordedBy String
  recordedAt String
}

model Contract {
  id                    String   @id
  customerId            String
  customerName          String
  projectId             String
  projectName           String
  contractDate          String
  attributedTo          String
  attributedToName      String
  projectAmount         Float
  settlementAmount      Float
  extraAmount           Float
  extraTaxIncluded      Boolean
  extraPaid             Boolean  @default(false)
  customerAttribute     String
  isFirstContract       Boolean
  approved              Boolean  @default(false)
  cancelled             Boolean  @default(false)
  submitted             Boolean  @default(false)
  stampContractUploaded Boolean  @default(false)
  invoiceUploaded       Boolean  @default(false)
  contractFile          String?
  invoiceFile           String?
  processFiles          String   @default("[]")  // JSON array

  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments              Payment[]
  archivedFiles         ArchivedFile[]
}

model Payment {
  id          String   @id
  contractId  String
  condition   String
  amount      Float
  completed   Boolean  @default(false)
  paymentDate String?
  voucherFile String?

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ArchivedFile {
  id         String @id
  contractId String
  name       String
  category   String
  data       String
  uploadedAt String

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// 外勤费用报销单（SOP：关联客户必填、一单多条明细、两级审核）
model Expense {
  id                String  @id
  customerId        String                 // 必填：CRM 已登记客户
  customerName      String
  visitId           String?                // 选填：关联外勤拜访记录（松散引用）
  fieldworkDate     String                 // 外勤时间
  fieldworkLocation String                 // 外勤地点
  workContent       String                 // 工作内容
  notes             String?                // 补充说明（超标准费用原因/用途/必要性）
  totalAmount       Float                  // = 明细合计（后端计算）
  status            String                 // pending_manager/pending_finance/pending_payment/paid/settled/rejected
  submittedById     String
  submittedByName   String
  rejectReason      String?
  rejectedByStage   String?                // 'manager' | 'finance'
  statusHistory     String  @default("[]") // JSON 审批流水 [{action, operatorId, operatorName, comment?, at}]
  attachments       String  @default("[]") // JSON [{name, data(base64), uploadedAt}] 票据凭证
  createdAt         String
  updatedAt         String

  items             ExpenseItem[]
  customer          Customer @relation(fields: [customerId], references: [id])
}

// 报销费用明细行
model ExpenseItem {
  id        String  @id
  expenseId String
  category  String   // 交通/差旅/住宿餐/招待/耗材/杂费
  amount    Float
  date      String   // 消费日期
  reason    String   // 消费事由

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Visit {
  id           String  @id
  date         String
  salesperson  String
  customerId   String
  customerName String
  location     String
  contact      String
  duration     Float
}

model Task {
  id         String  @id
  title      String
  content    String
  assignedBy String
  assignedTo String
  createdAt  String
  deadline   String
  completed  Boolean @default(false)
  status     String  @default("pending") // pending/submitted/completed
  source     String
}

model AuditLog {
  id         String @id
  userId     String
  userName   String
  action     String
  targetType String
  targetId   String?
  targetName String?
  detail     String
  timestamp  String
}

model Notification {
  id           String  @id
  type         String
  fromUserId   String
  fromUserName String
  toUserId     String
  customerId   String
  customerName String
  status       String
  createdAt    String
  read         Boolean @default(false)
  contractId   String?
  expenseId    String?
  taskId       String?
  comment      String? // 驳回原因等备注
}

model AppConfig {
  id    String @id
  value String // JSON value
}
